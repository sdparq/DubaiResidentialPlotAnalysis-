# Supabase cloud sync (optional — the app works without it).
# Project settings: https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Email of the single shared team account created in Supabase Auth.
# Everyone signs in with this email + the team password you set.
NEXT_PUBLIC_SUPABASE_SHARED_EMAIL=team@example.com

# Optional: admin-gate the Class Library (the shared price / unit-mix matrix).
# Put the SHA-256 hex of the admin password here, e.g.:
#   printf '%s' 'your-password' | shasum -a 256
# Leave it unset and the padlock in the tab bar opens the library directly.
NEXT_PUBLIC_LIBRARY_PASSWORD_SHA256=

# Optional: your own (paid or self-hosted) Overpass server for the 3D surroundings
# from OpenStreetMap. Without it the public servers are used — fine for light use.
NEXT_PUBLIC_OVERPASS_URL=
